generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./needfinder.db"
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  phone         String?   @unique
  firstName     String    @default("")
  lastName      String    @default("")
  displayName   String?
  avatar        String?
  bio           String?
  city          String?
  province      String?
  address       String?
  role          String    @default("CLIENT")
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  banReason     String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastSeenAt    DateTime?
  online        Boolean   @default(false)
  averageRating Float    @default(0)
  reviewCount   Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sentMessages       Message[]         @relation("SentMessages")
  sentProposals      Proposal[]
  requests           ServiceRequest[]
  reviews            Review[]
  givenReviews       Review[]         @relation("ReviewAuthor")
  wallet             Wallet?
  notifications      Notification[]
  portfolios         Portfolio[]
  skills             UserSkill[]
  transactions       Transaction[]
  authTokens         AuthToken[]
  conversations1     Conversation[]     @relation("ConvUser1")
  conversations2     Conversation[]     @relation("ConvUser2")
  reportsCreated     Report[]          @relation("ReportReporter")
  referralsGiven     Referral[]        @relation("Referrer")
  referral           Referral?
  bookmarks          Bookmark[]

  @@index([role])
  @@index([city])
  @@index([isVerified])
  @@index([isActive])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   @default("refresh")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============ CATEGORIES & SKILLS ============

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  image       String?
  embedding   Json?
  parentId    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryHierarchy")
  requests    ServiceRequest[]
  skills      Skill[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model Skill {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       UserSkill[]
  category    Category?     @relation(fields: [categoryId], references: [id])

  categoryId String?
  @@index([slug])
}

model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  level      Int      @default(1)
  experience String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ============ SERVICE REQUESTS ============

model ServiceRequest {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  description   String
  budgetMin     Int?
  budgetMax     Int?
  budgetType    String           @default("FIXED")
  deliveryTime  Int?
  deliveryUnit  String           @default("day")
  city          String?
  province      String?
  address       String?
  categoryId    String
  priority      String           @default("NORMAL")
  status        String           @default("OPEN")
  tags          String           @default("[]")
  attachmentUrls String          @default("[]")
  viewCount     Int              @default(0)
  proposalCount Int              @default(0)
  isFeatured    Boolean          @default(false)
  expiresAt     DateTime?
  closedAt      DateTime?
  selectedProposalId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user              User           @relation(fields: [userId], references: [id])
  userId            String
  category          Category       @relation(fields: [categoryId], references: [id])
  proposals         Proposal[]
  reviews           Review[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([slug])
}

// ============ PROPOSALS ============

model Proposal {
  id            String        @id @default(cuid())
  price         Int
  deliveryTime  Int?
  deliveryUnit  String        @default("day")
  message       String
  attachmentUrls String       @default("[]")
  status        String        @default("PENDING")
  isRead        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  requestId     String
  user          User          @relation(fields: [userId], references: [id])
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

// ============ PORTFOLIO ============

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrls   String   @default("[]")
  videoUrl    String?
  projectUrl  String?
  clientName  String?
  completedAt DateTime?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublished])
}

// ============ MESSAGES & CHAT ============

model Conversation {
  id          String   @id @default(cuid())
  requestId   String?
  userId1     String
  userId2     String
  lastMessage String?
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user1       User           @relation("ConvUser1", fields: [userId1], references: [id])
  user2       User           @relation("ConvUser2", fields: [userId2], references: [id])
  messages    Message[]

  @@index([userId1])
  @@index([userId2])
  @@index([requestId])
  @@index([lastMessageAt])
}

model Message {
  id          String        @id @default(cuid())
  conversationId String
  senderId    String
  content     String
  type        String        @default("TEXT")
  attachmentUrls String     @default("[]")
  isRead      Boolean       @default(false)
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender      User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
}

// ============ REVIEWS & RATINGS ============

model Review {
  id            String   @id @default(cuid())
  rating        Int
  qualityRating Int?
  timingRating  Int?
  communicationRating Int?
  professionalismRating Int?
  pros          String?
  cons          String?
  isRecommended Boolean @default(false)
  comment       String?
  response      String?
  isPublished   Boolean  @default(true)
  proposalId    String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authorId      String
  userId        String
  requestId     String
  author        User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  request       ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([authorId])
  @@index([userId])
  @@index([rating])
}

// ============ WALLET & PAYMENTS ============

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balance    Int      @default(0)
  frozen     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  walletId      String
  userId        String
  type          String
  amount        Int
  description   String?
  referenceId   String?
  metadata      String?
  status        String          @default("PENDING")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String   @default("{}")
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============ ADMIN & SYSTEM ============

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Report {
  id          String      @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  description String?
  isAnonymous Boolean     @default(false)
  status      String      @default("PENDING")
  resolvedBy  String?
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([targetType])
  @@index([targetId])
  @@index([status])
}

// ============ REFERRALS ============

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  code        String
  reward      Int      @default(0)
  isClaimed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  referrer User         @relation("Referrer", fields: [referrerId], references: [id])
  referred User         @relation(fields: [referredId], references: [id])
}

// ============ COUPONS ============

model Coupon {
  id          String        @id @default(cuid())
  code        String        @unique
  type        String        @default("PERCENTAGE")
  value       Int           @default(0)
  minOrder    Int           @default(0)
  maxUses     Int           @default(0)
  usedCount   Int           @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

// ============ BOOKMARKS ============

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  type      String
  targetId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([type])
  @@index([targetId])
}
