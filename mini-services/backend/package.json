{
  "name": "needfinder-backend",
  "version": "2.0.0",
  "description": "نیاز فایندر - NestJS Backend API (PostgreSQL + Redis + WebSocket + BullMQ)",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "seed": "bun run src/seed.ts",
    "typeorm:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/data-source.ts",
    "typeorm:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.6",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/platform-socket.io": "^10.4.6",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^10.4.6",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.30.6",
    "cache-manager": "^5.2.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "sqlite3": "^6.0.1",
    "@prisma/client": "^6.11.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "prisma": "^6.11.1",
    "@types/node": "^22.9.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2"
  }
}
