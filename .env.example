# Copy to .env.local for local development (not committed)

# --- Mapbox GL JS (browse maps, pin pickers) ---
# Required — free tier at https://account.mapbox.com
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional Mapbox Studio vector style (Snapp/Balad-class); omit to use Iran raster via /api/map/tiles
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-account/style-id

# --- Iran map tiles (self-hosted proxy + disk cache) ---
# Default: vector — Divar-style local map via /api/map/vector/iran (see docs/MAP_LOCAL_SETUP.md)
# NEXT_PUBLIC_MAP_SURFACE=vector
# Set to raster to force memaps/Carto tiles via /api/map/tiles (vector still used as fallback target on errors)
# NEXT_PUBLIC_MAP_SURFACE=raster
# MAP_VECTOR_CACHE_ENABLED=true
# MAP_TILE_UPSTREAM_LIGHT_URL=https://memaps.ir/light/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_DARK_URL=https://memaps.ir/dark/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_FALLBACK_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_CACHE_ENABLED=true

# --- Need intake (/post) — manual wizard, see docs/NEED_INTAKE.md ---
# No MLX / Qwen sidecar required. npm run dev is enough for browse + publish.

# Auto-approve after publish (dev/staging only; production: unset or false)
# NEED_INTAKE_AUTO_APPROVE=true
# NEED_AUTO_APPROVE_REQUESTS=true

# Dev UX — skip 250ms processing animation
# NEED_INTAKE_SKIP_PROCESSING_DELAY=true

# V2 chat intake — frozen; /v2 redirects to /post
NEXT_PUBLIC_V2_INTAKE_CANARY=false

# Phase 37 — local wizard draft persistence (IndexedDB)
# NEXT_PUBLIC_INTAKE_DRAFT_PERSISTENCE_ENABLED=true
# NEXT_PUBLIC_INTAKE_DRAFT_AUTOSAVE_MS=30000
# NEXT_PUBLIC_INTAKE_DRAFT_TTL_DAYS=7

# Phase 40 — auth & resume (pending publish, rate limit)
# NEXT_PUBLIC_INTAKE_REQUIRE_PHONE_VERIFY=false
# INTAKE_PUBLISH_CAPTCHA_ENABLED=false
# INTAKE_PUBLISH_RATE_LIMIT_PER_HOUR=12

# --- Security (required in production) ---
# INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
# CHAT_INTERNAL_SECRET=same-as-above-if-not-set
# SUPER_ADMIN_PHONES=09xxxxxxxxx
# ALLOW_TEST_OTP=true
# NEXT_PUBLIC_ALLOW_TEST_OTP=true
# TURN_STATIC_AUTH_SECRET=generate-strong-secret

# Deprecated — do not use for /post wizard:
# NEED_INTAKE_AI_ENABLED=false
