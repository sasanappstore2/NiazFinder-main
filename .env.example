# Copy to .env.local for local development (not committed)

# --- Mapbox GL JS (browse maps, pin pickers) ---
# Required — free tier at https://account.mapbox.com
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional Mapbox Studio vector style (Snapp/Balad-class); omit to use Iran raster via /api/map/tiles
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-account/style-id

# --- Iran map tiles (self-hosted proxy + disk cache) ---
# Default: vector — Divar-style local map via /api/map/vector/iran (see docs/MAP_LOCAL_SETUP.md)
# NEXT_PUBLIC_MAP_SURFACE=vector
# Set to raster to force memaps/Carto tiles via /api/map/tiles (vector still used as fallback target on errors)
# NEXT_PUBLIC_MAP_SURFACE=raster
# MAP_VECTOR_CACHE_ENABLED=true
# MAP_TILE_UPSTREAM_LIGHT_URL=https://memaps.ir/light/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_DARK_URL=https://memaps.ir/dark/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_FALLBACK_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_CACHE_ENABLED=true

# --- Need intake (/post) — Rules-first mode (AI off by default) ---
# NEED_INTAKE_RULES_ONLY=true
# NEXT_PUBLIC_NEED_INTAKE_RULES_ONLY=true
# NEED_INTAKE_LLM_ENABLED=false
# Intake rollout flags (set to false only for a controlled rollback)
# INTAKE_CANONICAL_DRAFT_V2=true
# INTAKE_SINGLE_ANALYZER=true
# INTAKE_ROOT_CATEGORY_HINT=true
# INTAKE_PUBLISH_IDEMPOTENCY=true
# INTAKE_SECURITY_GUARDS=true
# AI_SEMANTIC_RESOLVER_ENABLED=false
# Unified local LLM gateway (LM Studio OpenAI-compatible on :1234)
# LOCAL_LLM_ONLY=true
# LOCAL_LLM_PARALLEL_SLOTS=4
# NEED_INTAKE_HYBRID_ENABLED=true
# NEED_INTAKE_INTENT_SLICE_ENABLED=false
# NEED_INTAKE_INTENT_GIST_ENABLED=true
# NEED_INTAKE_INTENT_GIST_MAX_TOKENS=256
# NEED_INTAKE_INTENT_GIST_MAX_WORDS=25
# NEED_INTAKE_INTENT_GIST_PROVIDER=gemini
# NEED_INTAKE_DISAMBIG_AI_ENABLED=true
# NEED_INTAKE_LLM_URL=http://127.0.0.1:1234
# NEED_INTAKE_LLM_MODEL=gemma-4-E2B_q4_0-it.gguf
# NEED_INTAKE_LLM_TIMEOUT_MS=120000
# Legacy gemma4-intake sidecar (optional): MODEL_PATH=models/GEMMA/gemma-4-E2B_q4_0-it.gguf
# NEED_INTAKE_PARSE_CACHE_VERSION_BUMP=hybrid-v1
# NEED_INTAKE_TRUTH_VERIFY_ENABLED=false
# NEED_INTAKE_TRUTH_VERIFY_ALWAYS=false
# NEXT_PUBLIC_NEED_INTAKE_COPY_AI_ENABLED=false
# NEXT_PUBLIC_NEED_INTAKE_LIVE_COPY_ENABLED=false
# No MLX / Qwen sidecar required for rules-only intake.

# Auto-approve after publish (dev/staging only; production: unset or false)
# NEED_INTAKE_AUTO_APPROVE=true
# NEED_AUTO_APPROVE_REQUESTS=true

# Dev UX — skip 250ms processing animation
# NEED_INTAKE_SKIP_PROCESSING_DELAY=true

# Phase 40 — auth & resume (pending publish, rate limit)
# INTAKE_PUBLISH_CAPTCHA_ENABLED=false
# INTAKE_PUBLISH_RATE_LIMIT_PER_HOUR=12

# --- Intake wizard client flags ---
# Skip the need-confirmation step in the wizard (dev shortcut)
# NEXT_PUBLIC_INTAKE_SKIP_NEED_STEP=false
# Client telemetry sampling for /post (0..1)
# NEXT_PUBLIC_INTAKE_TELEMETRY_SAMPLE_RATE=1
# NEXT_PUBLIC_POST_INTAKE_TELEMETRY=true
# Client-side mirrors of intake AI flags (kept in sync with server flags above)
# NEXT_PUBLIC_NEED_INTAKE_HYBRID_ENABLED=true
# NEXT_PUBLIC_NEED_INTAKE_LLM_ENABLED=false
# NEXT_PUBLIC_NEED_INTAKE_LLM_TIMEOUT_MS=120000
# NEXT_PUBLIC_NEED_INTAKE_LIVE_COPY_DEBOUNCE_MS=600

# --- RabbitMQ (event-driven async: intake AI + analytics) ---
# RABBITMQ_URL=amqp://niazfinder:change_me@127.0.0.1:5672/
# RABBITMQ_USER=niazfinder
# RABBITMQ_PASSWORD=change_me
# RABBITMQ_ENABLED=true
# RABBITMQ_EXCHANGE=niazfinder_topic
# RABBITMQ_DLX=dlx_niazfinder
# RABBITMQ_DLQ=dlq_failed_tasks
# RABBITMQ_CONNECT_RETRIES=10
# RABBITMQ_CONNECT_DELAY_MS=3000
# RABBITMQ_PUBLISH_CONFIRM=true
# RABBITMQ_ROUTING_INTAKE=intake.ai
# RABBITMQ_ROUTING_ANALYTICS=analytics.telemetry
# RABBITMQ_ROUTING_MATCHING=business.match
# INTAKE_QUEUE=intake_ai_processing
# ANALYTICS_QUEUE=analytics_telemetry
# MATCHING_QUEUE=business_matching
# INTAKE_QUEUE_SYNC_FALLBACK=true
# MLX_INTAKE_URL=http://127.0.0.1:8100/analyze

# --- Typesense (business search) ---
# TYPESENSE_ENABLED=true
# TYPESENSE_API_KEY=niazfinder_typesense_dev_key
# TYPESENSE_HOST=127.0.0.1
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http

# --- Security (required in production) ---
# INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
# CHAT_INTERNAL_SECRET=same-as-above-if-not-set

# --- Chat / realtime (local dev) ---
# Required for typing / read receipts / live message delivery in development:
NEXT_PUBLIC_CHAT_SOCKET_URL=http://127.0.0.1:3004
# Legacy Nest /chat namespace toggle (leave unset for Bun chat-service)
# NEXT_PUBLIC_CHAT_SOCKET_USE_NEST_NAMESPACE=false
# Dedicated typing-indicator websocket (optional; defaults to chat socket)
# NEXT_PUBLIC_TYPING_WS_URL=
# CHAT_SERVICE_INTERNAL_URL=http://127.0.0.1:3004
# REDIS_URL=redis://127.0.0.1:6379
# Run chat gateway: npm run dev:chat  (loads repo-root .env automatically)
# Without Redis, REST + HTTP /internal/fanout still deliver messages in single-instance dev.
# Disable realtime entirely: NEXT_PUBLIC_CHAT_SOCKET_URL=off
# Prod CORS lock-down (comma-separated). Dev may omit (defaults to *):
# CHAT_CORS_ORIGINS=https://your-app.example

# --- Voice (optional — docker-compose.voice.yml) ---
# NEXT_PUBLIC_JANUS_WS_URL=ws://127.0.0.1:8188
# NEXT_PUBLIC_VOICE_RELAY_ONLY=true
# Iran ISP / symmetric NAT: prefer VOICE_RELAY_ONLY=true + coturn TURNS:443
# WebRTC ICE (defaults to public Google STUN when unset)
# NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
# NEXT_PUBLIC_TURN_HOST=turn.example.com
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
# Web push notifications (generate: npx web-push generate-vapid-keys)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Smart Matching / VIP Leads ---
# SMART_MATCHING_ENABLED=true
# LEAD_FEE_TOMAN=5000
# VIP_TTL_MS=10800000
# MAX_PRIVATE_LEADS_PER_BUSINESS=100
# MAX_ACTIVE_CHAT_SESSIONS_PER_NEED=3
# SMART_MATCHING_INTERNAL_SECRET=smart-matching-internal-dev
# NEST_API_URL=http://127.0.0.1:4000

# --- Pay-per-message AI Agent (platform bot chat) ---
# AI_AGENT_ENABLED=true
# AGENT_MESSAGE_FEE_TOMAN=500
# AGENT_LLM_PROVIDER=local
# AGENT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# AGENT_LLM_MODEL=gemma-4-E2B_q4_0-it.gguf
# AGENT_LLM_API_KEY=local
# AGENT_LLM_MAX_TOKENS=800
# AGENT_LLM_MAX_TOOL_ROUNDS=3
# PLATFORM_AI_USER_ID=
# EMBED_LLM_URL=http://127.0.0.1:8102
# EMBED_MODEL=multilingual-e5-small
# EMBED_DIMENSION=384
# EMBED_BATCH_SIZE=64
# EMBED_TIMEOUT_MS=30000

# --- LM Studio (recommended local dev — OpenAI-compatible on :1234) ---
# Load gemma-4-E2B_q4_0-it.gguf in LM Studio, start server, set Parallel Requests=4
# NEED_INTAKE_LLM_URL=http://127.0.0.1:1234
# NEED_INTAKE_LLM_MODEL=gemma-4-E2B_q4_0-it.gguf
# LOCAL_LLM_PARALLEL_SLOTS=4
# npm run verify:lm-studio-parallel

# --- Google Gemini (cloud — optional fallback or AI_PROVIDER=gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FALLBACK_ENABLED=true
# AI_PROVIDER=gemini

# --- Ollama (deprecated — use LM Studio instead) ---
# OLLAMA_URL=http://127.0.0.1:8101
# OLLAMA_MODEL=gemma4-e2b-it

# --- Intake queue (BullMQ via Nest) + GEMMA4 hybrid ---
# INTAKE_QUEUE_ENABLED=true
# INTAKE_QUEUE_SYNC_FALLBACK=true
# NEXT_PUBLIC_INTAKE_WIZARD_USE_QUEUE=true
# NEED_INTAKE_HYBRID_ENABLED=true
# NEED_INTAKE_LLM_URL=http://127.0.0.1:8100
# NEED_INTAKE_LLM_MODEL=gemma-4-e2b-q4_0-it
# NEST_API_URL=http://127.0.0.1:4000
# INTERNAL_API_SECRET=your-internal-secret

# --- Business site import (hub / onboarding — estate-scrape on :8200, intake-mlx on :8100) ---
# ESTATE_SCRAPE_URL=http://127.0.0.1:8200
# ESTATE_SCRAPE_SECRET=optional-shared-secret-must-match-estate-scrape-service
# SUPER_ADMIN_PHONES=09xxxxxxxxx
# ALLOW_TEST_OTP=true
# NEXT_PUBLIC_ALLOW_TEST_OTP=true

# --- Dev server: LAN / mobile access (Next.js 16 blocks HMR unless origin is allowlisted) ---
# Bind: npm run dev uses -H 0.0.0.0. When opening http://192.168.x.x:3000 add your origin:
# ALLOWED_DEV_ORIGINS=192.168.254.5:3000
# ALLOWED_DEV_ORIGINS=192.168.254.5:3000,192.168.0.0/16

# TURN_STATIC_AUTH_SECRET=generate-strong-secret

# --- Public URLs / misc client flags ---
# Absolute site origin used in canonical URLs / metadata
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# External API origin overrides (leave unset for same-origin /api)
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_NEST_API_URL=http://127.0.0.1:4000
# Filing demo gallery (dev showcase data on /f)
# NEXT_PUBLIC_FILING_DEMO_GALLERY=false

# Deprecated — do not use for /post wizard:
# NEED_INTAKE_AI_ENABLED=false

# --- /post natural-language intake: private Si Multilingual worker only ---
# SI_POST_URL=http://127.0.0.1:8101/predict
# SI_MODEL_NAME=convaiinnovations/si-multilingual
# SI_MODEL_PATH=
# SI_DEVICE=auto
# SI_CACHE_DIR=
# Calibrate this on a separate, human-labeled holdout before enabling auto-apply.
# SI_POST_MIN_CONFIDENCE=0.82
# SI_POST_AUTO_APPLY=false

# --- Payment Gateway (Zarinpal) — wallet top-up ---
# Merchant ID from https://next.zarinpal.com (sandbox works without a real merchant id)
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# ZARINPAL_SANDBOX=true
# WALLET_MIN_DEPOSIT_TOMAN=10000
# WALLET_MAX_DEPOSIT_TOMAN=50000000

# --- Monetization: bonuses & discounts ---
# SIGNUP_BONUS_TOMAN=100000
# REFERRAL_REWARD_TOMAN=50000
# PRO_LEAD_DISCOUNT_PERCENT=20
# BUSINESS_LEAD_DISCOUNT_PERCENT=30

# --- Lead pricing tiers (Toman, flat rate) ---
# STANDARD_LEAD_FEE_TOMAN=10000
# QUALITY_LEAD_FEE_TOMAN=20000

# --- Subscription plans (Toman, monthly, one-time wallet deduction — no auto-renew billing yet) ---
# PRO_PLAN_PRICE_TOMAN=200000
# BUSINESS_PLAN_PRICE_TOMAN=500000
