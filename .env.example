# Copy to .env.local for local development (not committed)

# --- Mapbox GL JS (browse maps, pin pickers) ---
# Required — free tier at https://account.mapbox.com
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...
# Optional Mapbox Studio vector style (Snapp/Balad-class); omit to use Iran raster via /api/map/tiles
# NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/your-account/style-id

# --- Iran map tiles (self-hosted proxy + disk cache) ---
# Default: vector — Divar-style local map via /api/map/vector/iran (see docs/MAP_LOCAL_SETUP.md)
# NEXT_PUBLIC_MAP_SURFACE=vector
# Set to raster to force memaps/Carto tiles via /api/map/tiles (vector still used as fallback target on errors)
# NEXT_PUBLIC_MAP_SURFACE=raster
# MAP_VECTOR_CACHE_ENABLED=true
# MAP_TILE_UPSTREAM_LIGHT_URL=https://memaps.ir/light/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_DARK_URL=https://memaps.ir/dark/{z}/{x}/{y}.png
# MAP_TILE_UPSTREAM_FALLBACK_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_CACHE_ENABLED=true

# --- Need intake (/post) — see docs/INTAKE_INDEX.md ---
#
# Strategy: Rules-First, AI-Enhance (docs/adr/001-intake-ai-strategy.md)
# CI: test:post-pipeline (rules-only) + test:post-mlx-gate (requires MLX)

# MLX sidecar — npm run dev:intake-mlx (port 8100)
NEED_INTAKE_LLM_ENABLED=true
NEED_INTAKE_LLM_URL=http://127.0.0.1:8100
NEED_INTAKE_LLM_TIMEOUT_MS=12000

# Listing copy stream (SSE) — uses MLX /v1/listing-copy when true
# NEED_INTAKE_COPY_AI_ENABLED=true

# Title generation — false = template/heuristic only
# NEED_INTAKE_TITLE_AI_ENABLED=true

# Dev UX — skip 250ms processing animation
# NEED_INTAKE_SKIP_PROCESSING_DELAY=true

# Parse result cache TTL (ms) — server-side
# NEED_INTAKE_PARSE_CACHE_TTL_MS=900000

# Auto-approve after publish (dev/staging only; production: unset or false)
# NEED_INTAKE_AUTO_APPROVE=true
# NEED_AUTO_APPROVE_REQUESTS=true

# Homepage: analyze preview before /post (dev)
# NEXT_PUBLIC_INTAKE_HOME_PREVIEW=1

# Home → /post: skip need step when seed is strong (40+ chars). false = A/B control
# NEXT_PUBLIC_INTAKE_SKIP_NEED_STEP=false

# Mobile intake (phase 27): optional voice mic + haptic on step complete
# NEXT_PUBLIC_INTAKE_VOICE_INPUT=true
# NEXT_PUBLIC_INTAKE_HAPTIC=true

# Mobile intake (phase 29): offline publish queue toast when network returns
# NEXT_PUBLIC_INTAKE_OFFLINE_PUBLISH_QUEUE=true

# V2 chat intake — frozen; /v2 redirects to /post
NEXT_PUBLIC_V2_INTAKE_CANARY=false

# Analyze provider facade (phase 31): auto | rules | mlx | cloud
# NEED_INTAKE_AI_PROVIDER=auto

# Reconcile merge (phase 32): AI confidence threshold + debug conflicts
# INTAKE_RECONCILE_CONFIDENCE_THRESHOLD=0.7
# INTAKE_RECONCILE_DEBUG=true

# Confidence-driven UX (phase 33): hide filled fields when AI confidence is high
# NEXT_PUBLIC_INTAKE_CONFIDENCE_SKIP_THRESHOLD=0.75
# NEXT_PUBLIC_INTAKE_CONFIDENCE_AB_VARIANT=low|high

# Intake telemetry (phase 36): 10% production sampling
# NEXT_PUBLIC_INTAKE_TELEMETRY_SAMPLE_RATE=0.1

# Phase 37 — local wizard draft persistence (IndexedDB)
# NEXT_PUBLIC_INTAKE_DRAFT_PERSISTENCE_ENABLED=true
# NEXT_PUBLIC_INTAKE_DRAFT_AUTOSAVE_MS=30000
# NEXT_PUBLIC_INTAKE_DRAFT_TTL_DAYS=7
# NEXT_PUBLIC_INTAKE_DRAFT_OBFUSCATE=false

# Phase 42 — admin self-service intake field specs (runtime overlay)
# INTAKE_FIELD_SPEC_STORE_PATH=data/intake-field-spec-overrides.json

# Phase 45 — duplicate & quality gate
# INTAKE_DUPLICATE_WARN_THRESHOLD=0.8
# INTAKE_DUPLICATE_BLOCK_THRESHOLD=0.95
# INTAKE_PUBLISH_VELOCITY_MAX=3
# INTAKE_PUBLISH_VELOCITY_WINDOW_MS=600000
# INTAKE_PROFANITY_FILTER_ENABLED=true
# INTAKE_DUPLICATE_OVERRIDE_SECRET=generate-strong-secret

# Phase 48 — edit & resubmit flow
# INTAKE_EDIT_ENABLED=true

# Phase 50 — autonomous quality & governance
# INTAKE_GOVERNANCE_ENABLED=true
# INTAKE_AUTO_MOD_PASS_THRESHOLD=70
# INTAKE_AUTO_MOD_CONFIDENCE_MIN=0.75
# INTAKE_MODERATION_SLA_HOURS=24
# INTAKE_CANARY_NEED_TYPES=
# INTAKE_PUBLISH_ANOMALY_Z_THRESHOLD=3
# INTAKE_CONFORMANCE_RECERT_DAYS=90

# Phase 49 — schema v2 & public API
# INTAKE_PUBLIC_API_ENABLED=true
# INTAKE_PARTNER_API_KEYS=[{"key":"sk_test_xxx","partnerId":"acme","tier":"partner","ownerUserId":"<user-uuid>"}]
# INTAKE_PUBLIC_API_RATE_FREE_PER_HOUR=60
# INTAKE_PUBLIC_API_RATE_PARTNER_PER_HOUR=600
# INTAKE_PUBLIC_API_RATE_MOBILE_PER_HOUR=120
# INTAKE_MOBILE_API_ONLY=false
# INTAKE_V0_DEPRECATION_DATE=2026-08-01

# Phase 47 — parse cache + MLX cluster
# NEED_INTAKE_PARSE_CACHE_ENABLED=true
# NEED_INTAKE_PARSE_CACHE_TTL_MS=900000
# INTAKE_PARSE_CACHE_VERSION_BUMP=0
# NEED_INTAKE_LLM_URL=http://127.0.0.1:8100
# NEED_INTAKE_LLM_URL_2=http://127.0.0.1:8101
# NEED_INTAKE_LLM_URLS=http://127.0.0.1:8100,http://127.0.0.1:8101
# INTAKE_MLX_AB_VARIANT=a
# INTAKE_MLX_MODEL_ID=mlx-community/Qwen3.5-2B-bf16
# INTAKE_REDIS_MEMORY_WARN_BYTES=268435456

# Phase 46 — async intake queue (BullMQ via Nest)
# INTAKE_QUEUE_ENABLED=true
# INTAKE_QUEUE_SYNC_FALLBACK=true
# INTAKE_QUEUE_PAID_PRIORITY=1
# INTAKE_QUEUE_DEFAULT_PRIORITY=5
# INTAKE_QUEUE_LOAD_TARGET_JOBS_PER_MIN=200

# Phase 43 — vehicles vertical launch flag
# INTAKE_VEHICLES_VERTICAL_ENABLED=true
# NEXT_PUBLIC_INTAKE_VEHICLES_VERTICAL_ENABLED=true

# Phase 40 — auth & resume (pending publish, rate limit, spam guard)
# NEXT_PUBLIC_INTAKE_REQUIRE_PHONE_VERIFY=false
# INTAKE_PUBLISH_CAPTCHA_ENABLED=false
# INTAKE_PUBLISH_RATE_LIMIT_PER_HOUR=12
# INTAKE_PUBLISH_DUPLICATE_WARN=true

# Title/Copy pipeline v2 (phase 35)
# NEED_INTAKE_TITLE_AI_PROVIDER=template|mlx
# NEED_INTAKE_COPY_AI_PROVIDER=template|mlx
# NEXT_PUBLIC_INTAKE_BLOCK_LOW_QUALITY_PUBLISH=true
# INTAKE_MLX_VERTICAL=real-estate

# MLX circuit breaker (phase 34): transport failures → rules-only fallback
# INTAKE_MLX_CIRCUIT_ENABLED=true
# INTAKE_MLX_CIRCUIT_FAILURE_THRESHOLD=3
# INTAKE_MLX_CIRCUIT_OPEN_MS=60000
# INTAKE_MLX_CIRCUIT_DEBUG=true

# Legacy cloud AI fallback when MLX off — rarely needed
# AI_SEMANTIC_RESOLVER_ENABLED=false

# Estate scrape microservice — optional
# ESTATE_SCRAPE_URL=http://127.0.0.1:8200

# MLX adapter override (default: scripts/dev/resolve-intake-mlx-adapter.sh)
# INTAKE_MLX_ADAPTER_PATH=../../models/estate-intake-lora-v1

# --- Security (required in production) ---
# INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
# CHAT_INTERNAL_SECRET=same-as-above-if-not-set
# SUPER_ADMIN_PHONES=09xxxxxxxxx
# ALLOW_TEST_OTP=true
# NEXT_PUBLIC_ALLOW_TEST_OTP=true
# TURN_STATIC_AUTH_SECRET=generate-strong-secret

# Deprecated — do not use for /post wizard:
# NEED_INTAKE_AI_ENABLED=false
