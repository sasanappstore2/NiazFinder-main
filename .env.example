# Copy to .env.local for local development (not committed)

# --- Need intake AI (Qwen via MLX on Mac) ---
NEED_INTAKE_LLM_ENABLED=true
NEED_INTAKE_LLM_URL=http://127.0.0.1:8100
NEED_INTAKE_LLM_TIMEOUT_MS=12000

# Set false to force template titles only (skip Qwen title generation)
# NEED_INTAKE_TITLE_AI_ENABLED=true

# Optional: show parse preview on homepage (dev) before navigating to /post
# NEXT_PUBLIC_INTAKE_HOME_PREVIEW=1

# NEED_INTAKE_SKIP_PROCESSING_DELAY=true

# --- Security (required in production) ---
# INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32
# CHAT_INTERNAL_SECRET=same-as-above-if-not-set
# SUPER_ADMIN_PHONES=09xxxxxxxxx
# ALLOW_TEST_OTP=true
# NEXT_PUBLIC_ALLOW_TEST_OTP=true
# TURN_STATIC_AUTH_SECRET=generate-strong-secret

# Legacy — not used for need intake when NEED_INTAKE_LLM_ENABLED=true:
# NEED_INTAKE_AI_ENABLED=false
# AI_SEMANTIC_RESOLVER_ENABLED=false
