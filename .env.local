# Need intake — Gemma 4 MLX (local fine-tuned LoRA)
NEED_INTAKE_AI_ENABLED=true
NEED_INTAKE_AI_PROVIDER=mlx
NEED_INTAKE_AI_TIMEOUT_MS=60000
NEED_INTAKE_ENRICH_TIMEOUT_MS=25000

# Local model API (LM Studio / llama.cpp — OpenAI-compatible)
NEED_INTAKE_LLM_ENABLED=true
NEED_INTAKE_LLM_URL=http://127.0.0.1:1234
NEED_INTAKE_LLM_MODEL=gemma
NEED_INTAKE_LLM_TIMEOUT_MS=60000
AI_PROVIDER=local-llm
AI_SEMANTIC_RESOLVER_ENABLED=true
NEED_INTAKE_TRUTH_VERIFY_ENABLED=true
NEED_INTAKE_TRUTH_VERIFY_LEAN=true
NEED_INTAKE_LOC_SKIP_PRISMA=true
NEED_INTAKE_COPY_AI_ENABLED=true
NEED_INTAKE_TITLE_AI_ENABLED=true
NEED_ASSESSMENT_MLX_ENABLED=true
NEED_INTAKE_ASSESS_CHAT_AI_ENABLED=true
NEED_INTAKE_ASSESS_CHAT_ENRICH_ENABLED=true
NEED_INTAKE_DUPLICATE_CHECK_ENABLED=true

# Gemma 4 adapter metadata (Next.js telemetry / A-B)
INTAKE_MLX_ADAPTER_PATH=models/gemma4-intake-lora-v1
INTAKE_MLX_MODEL_ID=models/google:gemma-4-12B-it-qat-w4a16-ct

# Bust stale parse cache after model swap
NEED_INTAKE_PARSE_CACHE_VERSION_BUMP=gemma4-intake-v1

# Intake queue (sync fallback for local M1 / Gemma sidecar)
INTAKE_QUEUE_ENABLED=true
INTAKE_QUEUE_SYNC_FALLBACK=true
NEXT_PUBLIC_INTAKE_WIZARD_USE_QUEUE=true
NEXT_PUBLIC_NEED_INTAKE_LLM_TIMEOUT_MS=120000

# Owner phone(s) with full super-admin access (comma-separated)
SUPER_ADMIN_PHONES=09374333028
