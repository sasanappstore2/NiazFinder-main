# Local LLM via LM Studio (Gemma-4-E2B OpenAI-compatible server)
LOCAL_LLM_ONLY=true
LOCAL_LLM_PARALLEL_SLOTS=4
NEED_INTAKE_LLM_ENABLED=true
NEED_INTAKE_LLM_URL=http://127.0.0.1:1234
NEED_INTAKE_LLM_MODEL=gemma-4-E2B_q4_0-it.gguf
NEED_INTAKE_LLM_TIMEOUT_MS=120000
AI_PROVIDER=local-llm
AI_SEMANTIC_RESOLVER_ENABLED=true
NEED_INTAKE_TRUTH_VERIFY_ENABLED=true
NEED_INTAKE_TRUTH_VERIFY_LEAN=true
NEED_INTAKE_LOC_SKIP_PRISMA=true

# Bust stale parse cache after model swap
NEED_INTAKE_PARSE_CACHE_VERSION_BUMP=lm-studio-v1

# Intake queue (sync fallback for local dev)
INTAKE_QUEUE_ENABLED=true
INTAKE_QUEUE_SYNC_FALLBACK=true
NEXT_PUBLIC_INTAKE_WIZARD_USE_QUEUE=true
NEXT_PUBLIC_NEED_INTAKE_LLM_TIMEOUT_MS=120000

# Owner phone(s) with full super-admin access (comma-separated)
SUPER_ADMIN_PHONES=09374333028

# Hybrid intake + platform AI agent (same LM Studio gateway)
NEED_INTAKE_HYBRID_ENABLED=true
AI_AGENT_ENABLED=true
AGENT_MESSAGE_FEE_TOMAN=500
AGENT_LLM_PROVIDER=local
AGENT_LLM_BASE_URL=http://127.0.0.1:1234/v1
AGENT_LLM_MODEL=gemma-4-E2B_q4_0-it.gguf
AGENT_LLM_API_KEY=local
AGENT_LLM_MAX_TOOL_ROUNDS=3
AGENT_LLM_TIMEOUT_MS=120000
NEST_API_URL=http://127.0.0.1:4000

# Google Gemini (free tier — cloud fallback when LM Studio is down)
GEMINI_API_KEY=AQ.Ab8RN6J3rNNhidT-yKAWbaw8Fg6onPDBL1DkUuc5JNvjJ6hrMg
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_ENABLED=true

# ≤10-word AI intent gist before rules (token-cheap, cached 24h)
NEED_INTAKE_INTENT_GIST_ENABLED=true
NEED_INTAKE_INTENT_GIST_MAX_TOKENS=512
NEED_INTAKE_INTENT_GIST_MAX_WORDS=25
NEED_INTAKE_INTENT_GIST_PROVIDER=gemini
NEED_INTAKE_INTENT_GIST_LOCAL_TIMEOUT_MS=4000

# Chat / realtime (chat-service on :3004 — see docs/CHAT_DEV_RUNBOOK.md)
NEXT_PUBLIC_CHAT_SOCKET_URL=http://127.0.0.1:3004
CHAT_SERVICE_INTERNAL_URL=http://127.0.0.1:3004

# Typesense (business search — docker compose service on :8108)
TYPESENSE_ENABLED=true
TYPESENSE_API_KEY=niazfinder_typesense_dev_key
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# RabbitMQ (async queues — docker compose on :5672)
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://niazfinder:change_me@127.0.0.1:5672/

# LAN / mobile dev (Next.js 16 HMR — see docs/DEV_TROUBLESHOOTING.md)
ALLOWED_DEV_ORIGINS=192.168.254.5:3000
