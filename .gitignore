# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
# root uses npm only (chat-service keeps its own bun.lock)
/bun.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# env (never commit secrets)
.env
.env.*
!.env.example

# misc
.DS_Store
# stale local snapshots (never track backups in git)
*.backup.*
src/intake.backup.*
# frozen QA fixtures (kept locally, not part of the build)
archive/intake-v2-golden/
# notebook outputs and canvas scratch
*.ipynb
*.canvas
# scratch probes and local temp files
tmp/
data/telemetry/post-intake/
data/evolution/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# MaxMind GeoLite2 (download separately)
data/GeoLite2-City.mmdb
*.mmdb


# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# need-intake training exports + local MLX weights (never commit)
# NOTE: bare `data/` is intentionally NOT ignored — small curated files under
# src/data (geo overrides, derived map JSON, neighborhood catalogs) are tracked.
/data/
src/data/geo/raw/
src/data/geo/provinces/
src/data/geo/viewports/
src/data/geo/*-boundaries.geojson
src/data/neighborhoods/known-areas.json
src/data/neighborhoods/geo/
src/data/neighborhoods/.cache/
src/data/iran-locations-tree.json
# discovery caches
.cache/
# generated filing benchmark reports
reports/filing-benchmark/
exports/intake-finetune/need-intake-general-finetune.jsonl
exports/intake-finetune/need-intake-general-finetune.json
exports/intake-finetune/need-intake-clean-v1.jsonl
exports/intake-finetune/need-intake-clean-v1.json
exports/intake-finetune/need-intake-clean-v2.jsonl
exports/intake-finetune/need-intake-clean-v2.json
exports/intake-finetune/gemma4-intake-full.jsonl
exports/intake-finetune/gemma4-intake-train-10k.jsonl
exports/intake-finetune/gemma4-intake-holdout-500.jsonl
exports/intake-finetune/gemma4-intake-full.json
exports/intake-finetune/dataset-index-batches.jsonl
models/
mini-services/*/.venv/
# Local chat uploads (do not commit)
public/uploads/chat/

mini-services/intake-mlx/__pycache__/
mini-services/intake-mlx/.env
*.adapter.*

# python bytecode (all services/scripts)
__pycache__/
*.py[cod]

# obsidian workspace settings (docs themselves stay tracked)
.obsidian/

# build artifacts & generated reports (keep .gitkeep + human-readable summaries)
mini-services/backend/dist/
reports/*.json
reports/*.csv
reports/*.jsonl
reports/**/*.json
reports/**/*.csv
reports/**/*.jsonl
!reports/.gitkeep
mobile/node_modules
mobile/ios/App/App/public
mobile/ios/DerivedData

# private inference runtime deps (not part of the public repo)
mini-services/si-post/requirements.local.txt
