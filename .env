# Database (PostgreSQL)
DATABASE_URL=postgresql://needfinder:change_me@localhost:5432/needfinder?schema=public

# Optional mini-service Postgres defaults
POSTGRES_USER=needfinder
POSTGRES_PASSWORD=change_me
POSTGRES_DB=needfinder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# Fanout Next.js → chat-service (HTTP fallback; Redis is primary)
INTERNAL_API_SECRET=dev-local-internal-secret

# App
JWT_SECRET=replace_with_secure_value
NODE_ENV=development

# Test OTP 1234 for local/staging (set false or remove before real deploy)
ALLOW_TEST_OTP=true
NEXT_PUBLIC_ALLOW_TEST_OTP=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Smart Matching / VIP Leads
SMART_MATCHING_ENABLED=true
LEAD_FEE_TOMAN=5000
VIP_TTL_MS=10800000
MAX_PRIVATE_LEADS_PER_BUSINESS=100
MAX_ACTIVE_CHAT_SESSIONS_PER_NEED=3
SMART_MATCHING_INTERNAL_SECRET=smart-matching-internal-dev
