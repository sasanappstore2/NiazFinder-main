# Database (PostgreSQL)
DATABASE_URL=postgresql://needfinder:change_me@localhost:5432/needfinder?schema=public

# Optional mini-service Postgres defaults
POSTGRES_USER=needfinder
POSTGRES_PASSWORD=change_me
POSTGRES_DB=needfinder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# App
JWT_SECRET=replace_with_secure_value
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
