{
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.experimental.useFlatConfig": true,
  "eslint.workingDirectories": [{ "directory": ".", "changeProcessCWD": true }],
  "eslint.validate": [],
  "eslint.probe": [],
  "eslint.run": "onSave",
  "eslint.options": {
    "ignorePatterns": ["nellavio/**", "ml/**", "mini-services/**", ".next/**", "**/*"]
  },
  "eslint.rules.customizations": [
    { "rule": "*", "severity": "off" }
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "typescript.tsserver.watchOptions": {
    "excludeDirectories": ["**/nellavio", "**/ml", "**/mini-services", "**/node_modules", "**/.next"]
  },
  "tailwindCSS.experimental.configFile": "src/app/globals.css",
  "tailwindCSS.validate": false,
  "tailwindCSS.lint.cssConflict": "ignore",
  "tailwindCSS.lint.invalidApply": "ignore",
  "tailwindCSS.lint.invalidScreen": "ignore",
  "tailwindCSS.lint.invalidVariant": "ignore",
  "tailwindCSS.lint.invalidConfigPath": "ignore",
  "tailwindCSS.lint.invalidTailwindDirective": "ignore",
  "tailwindCSS.lint.recommendedVariantOrder": "ignore",
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore",
  "tailwindCSS.emmetCompletions": true,
  "css.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "scss.validate": false,
  "less.validate": false,
  "files.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "**/nellavio": true,
    "**/ml": true,
    "**/mini-services": true
  },
  "files.watcherExclude": {
    "**/nellavio/**": true,
    "**/ml/**": true,
    "**/mini-services/**": true,
    "**/.next/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/nellavio": true,
    "**/ml": true,
    "**/mini-services": true,
    "**/.next": true
  }
}
