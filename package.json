{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3000 2>&1 | tee dev.log",
    "postinstall": "prisma generate",
    "dev:chat": "cd mini-services/chat-service && bun run dev",
    "dev:backend": "cd mini-services/backend && bun run dev",
    "dev:intake-mlx": "cd mini-services/intake-mlx && (test -d .venv/bin || python3 -m venv .venv) && .venv/bin/pip install -q -r requirements.txt && INTAKE_MLX_MODEL_ID=../../models/Qwen3.5-2B-bf16 INTAKE_MLX_ADAPTER_PATH=../../models/intake-lora .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100",
    "smoke:intake-mlx": "python3 mini-services/intake-mlx/scripts/smoke_infer.py",
    "train:intake-mlx": "curl -s -X POST http://127.0.0.1:8100/train",
    "smoke:routes": "npx --yes tsx scripts/health/smoke-routes.ts",
    "smoke:api": "npx --yes tsx scripts/health/smoke-api.ts",
    "smoke:need-intake-home-parse": "npx --yes tsx scripts/health/smoke-need-intake-home-parse.ts",
    "health:baseline": "npx --yes tsx scripts/health/collect-baseline.ts",
    "health:inventory": "npx --yes tsx scripts/health/api-inventory.ts",
    "check:all": "prisma validate && npx tsc --noEmit && eslint src && npm run build && npm run test:typing-analysis && npm run test:category-filters && npm run test:intake-parser && npm run test:intake-flow && npm run test:intake-dataset",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint src",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:intake-parser": "npx --yes tsx src/lib/need-intake/fixtures/run-parser-self-test.ts",
    "test:intake-flow": "NEED_INTAKE_SKIP_PROCESSING_DELAY=true npx --yes tsx src/lib/need-intake/fixtures/run-intake-flow-self-test.ts",
    "test:intake-prefill": "npx --yes tsx src/lib/need-intake/fixtures/run-extract-slots-self-test.ts && npx --yes tsx src/lib/need-intake/fixtures/run-prefill-flow-self-test.ts",
    "test:intake-dataset": "npx --yes tsx src/lib/need-intake/fixtures/run-dataset-self-test.ts",
    "export:intake-dataset": "EXPORT_DATASET=1 npx --yes tsx src/lib/need-intake/fixtures/run-dataset-self-test.ts",
    "generate:intake-estate-dataset": "npx --yes tsx src/lib/need-intake/dataset/run-generate-real-estate.ts",
    "test:category-filters": "npx --yes tsx src/lib/category-filters/run-registry-self-test.ts",
    "test:typing-analysis": "npx --yes tsx src/lib/typing-analysis/run-self-test.ts",
    "test:business-onboarding": "npx --yes tsx src/lib/business/fixtures/run-onboarding-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-normalize-web-presence-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-profile-slug-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-profile-completion-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-offer-storefront-meta-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-need-occupation-map-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-occupation-registry-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-online-store-registry-self-test.ts && npx --yes tsx src/lib/business/fixtures/run-browse-category-filter-self-test.ts",
    "migrate:business-occupations": "npx --yes tsx scripts/business/migrate-category-to-occupation.ts",
    "backfill:business-onboarding": "npx --yes tsx scripts/business/backfill-onboarding.ts",
    "seed:moderation-queue": "npx --yes tsx scripts/seed-moderation-queue.ts",
    "seed:business-profile-demos": "npx --yes tsx scripts/seed-business-profile-demos.ts",
    "seed:mashhad-neighborhoods": "npx --yes tsx scripts/seed-mashhad-neighborhoods.ts",
    "neighborhoods:import": "npx --yes tsx scripts/neighborhoods/import-from-divar.ts",
    "neighborhoods:import:city": "npx --yes tsx scripts/neighborhoods/import-from-divar.ts",
    "neighborhoods:validate": "npx --yes tsx scripts/neighborhoods/validate-coverage.ts",
    "neighborhoods:fix-manifest": "npx --yes tsx scripts/neighborhoods/fix-manifest.ts",
    "neighborhoods:build-manual-map": "npx --yes tsx scripts/neighborhoods/build-manual-map.ts",
    "categories:sync": "npx --yes tsx scripts/sync-categories.ts",
    "test:category-parity": "npx --yes tsx scripts/category-parity-check.ts",
    "divar:research": "npx --yes tsx scripts/divar/research-real-estate-posts.ts"
  },
  "dependencies": {
