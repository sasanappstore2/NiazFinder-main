generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  phone         String?   @unique
  username      String?   @unique
  firstName     String    @default("")
  lastName      String    @default("")
  displayName   String?
  avatar        String?
  coverImage    String?
  website       String?
  bio           String?
  city          String?
  province      String?
  address       String?
  role          UserRole  @default(CLIENT)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  banReason     String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastSeenAt    DateTime?
  online        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sentMessages            Message[]              @relation("SentMessages")
  messageDeliveries       MessageDelivery[]
  messageReactions        MessageReaction[]
  messageStars            MessageStar[]
  conversationMutes       ConversationMute[]
  blockedUsers            UserBlock[]            @relation("UserBlocks")
  blockedByUsers          UserBlock[]            @relation("BlockedByUsers")
  sentProposals           Proposal[]
  requests                ServiceRequest[]
  reviews                 Review[]
  givenReviews            Review[]               @relation("ReviewAuthor")
  wallet                  Wallet?
  notifications           Notification[]
  portfolios              Portfolio[]
  skills                  UserSkill[]
  transactions            Transaction[]
  authTokens              AuthToken[]
  staffRoles              UserStaffRole[]
  adminAuditLogs          AdminAuditLog[]
  conversations1          Conversation[]         @relation("ConvUser1")
  conversations2          Conversation[]         @relation("ConvUser2")
  posts                   UserPost[]
  postComments            PostComment[]
  postLikes               PostLike[]
  bookmarks               Bookmark[]
  followers               Follow[]               @relation("Followers")
  following               Follow[]               @relation("Following")
  businessProfile         BusinessProfile?
  callsAsCaller           VoiceCall[]            @relation("VoiceCallsAsCaller")
  callsAsCallee           VoiceCall[]            @relation("VoiceCallsAsCallee")
  reviewedRequests        ServiceRequest[]       @relation("ReviewedRequests")
  assignedRequests        ServiceRequest[]       @relation("AssignedRequests")
  needBrowseAlerts        NeedBrowseAlert[]
  analyticsSessions       AnalyticsSession[]
  businessMemberships     BusinessMember[]
  assignedContactPoints   BusinessContactPoint[] @relation("ContactPointAssignee")
  businessInvitesSent     BusinessMemberInvite[] @relation("BusinessInviteInviter")
  businessInvitesAccepted BusinessMemberInvite[] @relation("BusinessInviteAcceptor")
  chatReplyTemplates      ChatReplyTemplate[]
  staffAuditLogs          StaffAuditLog[]
  agentMemory             AgentUserMemory?
  agentConversationSummaries AgentConversationSummary[]

  @@index([role])
  @@index([city])
  @@index([isVerified])
  @@index([isActive])
}

enum UserRole {
  CLIENT
  SPECIALIST
  ADMIN
  SUPER_ADMIN
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   @default("refresh")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============ STAFF RBAC (Super Admin) ============

model StaffRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions StaffRolePermission[]
  users       UserStaffRole[]

  @@unique([name])
  @@index([isActive])
}

model StaffPermission {
  /**
   * Canonical permission id, e.g. `geo:locations:write`.
   * Source of truth in code: `src/config/admin-permissions.ts`.
   */
  id          String   @id
  label       String
  group       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles StaffRolePermission[]

  @@index([group])
}

model StaffRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       StaffRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission StaffPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserStaffRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  payload     String   @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============ INTAKE LOCATION CATALOG (Intelligence Engine v1) ============

model IntakeProvince {
  id        String                @id @default(cuid())
  slug      String                @unique
  name      String
  nameEn    String?
  isActive  Boolean               @default(true)
  cities    IntakeCity[]
  aliases   IntakeLocationAlias[] @relation("ProvinceAliases")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([slug])
  @@map("intake_provinces")
}

model IntakeCity {
  id            String                @id @default(cuid())
  slug          String                @unique
  name          String
  nameEn        String?
  provinceId    String
  province      IntakeProvince        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  isActive      Boolean               @default(true)
  lat           Float?
  lng           Float?
  neighborhoods IntakeNeighborhood[]
  aliases       IntakeLocationAlias[] @relation("CityAliases")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([provinceId])
  @@index([slug])
  @@map("intake_cities")
}

model IntakeNeighborhood {
  id        String                @id @default(cuid())
  slug      String
  name      String
  nameEn    String?
  cityId    String
  city      IntakeCity            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  areas     String[]              @default([])
  lat       Float?
  lng       Float?
  bbox      Json?
  isActive  Boolean               @default(true)
  aliases   IntakeLocationAlias[] @relation("NeighborhoodAliases")
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([slug])
  @@map("intake_neighborhoods")
}

model IntakeLocationAlias {
  id             String              @id @default(cuid())
  alias          String
  aliasRaw       String?
  neighborhoodId String?
  cityId         String?
  provinceId     String?
  neighborhood   IntakeNeighborhood? @relation("NeighborhoodAliases", fields: [neighborhoodId], references: [id], onDelete: Cascade)
  city           IntakeCity?         @relation("CityAliases", fields: [cityId], references: [id], onDelete: Cascade)
  province       IntakeProvince?     @relation("ProvinceAliases", fields: [provinceId], references: [id], onDelete: Cascade)
  source         String              @default("import")
  createdAt      DateTime            @default(now())

  @@index([alias])
  @@map("intake_location_aliases")
}

// ============ AGENT RAG LOCATION HIERARCHY (pgvector) ============

enum LocationType {
  PROVINCE
  CITY
  NEIGHBORHOOD
}

model Location {
  id       String       @id @default(cuid())
  slug     String
  name     String
  nameEn   String?
  type     LocationType
  parentId String?
  parent   Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Location[]   @relation("LocationTree")

  semanticPath String?
  areas        String[] @default([])
  lat          Float?
  lng          Float?

  embedding      Unsupported("vector(384)")?
  embeddingModel String?
  embeddedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([slug])
  @@index([parentId])
  @@map("locations")
}

// ============ INTAKE AGENT RAG (tiered pgvector) ============

enum IntakeDomain {
  NEEDS
  BUSINESS
}

/**
 * Level 1: semantic routing — categories & occupations (~500 rows).
 */
model IntakeCategoryRoute {
  id         String       @id @default(cuid())
  domain     IntakeDomain
  slug       String
  parentSlug String?
  title      String
  depth      Int          @default(0)
  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description          String
  semanticPath         String?
  technicalConstraints Json    @default("{}")
  ruleCount            Int     @default(0)

  embedding      Unsupported("vector(384)")?
  embeddingModel String?
  embeddedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleDocuments IntakeRuleDocument[]

  @@unique([domain, slug])
  @@index([domain])
  @@index([categoryId])
  @@index([parentSlug])
  @@map("intake_category_routes")
}

/**
 * Level 2: intake rules & business capabilities (up to ~2M rows).
 */
model IntakeRuleDocument {
  id              String               @id @default(cuid())
  domain          IntakeDomain
  categorySlug    String
  categoryRouteId String?
  categoryRoute   IntakeCategoryRoute? @relation(fields: [categoryRouteId], references: [id], onDelete: SetNull)

  ruleKey    String
  ruleKind   String
  pattern    String
  bundleType String @default("match")

  description          String
  technicalConstraints Json   @default("{}")

  searchText     String?
  embedding      Unsupported("vector(384)")?
  embeddingModel String?
  embeddedAt     DateTime?
  priority       Int                         @default(0)
  weight         Float                       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domain, ruleKey])
  @@index([domain, categorySlug])
  @@index([categoryRouteId])
  @@index([bundleType])
  @@map("intake_rule_documents")
}

// ============ CATEGORIES & SKILLS ============

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  image       String?
  parentId    String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent               Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children             Category[]            @relation("CategoryHierarchy")
  requests             ServiceRequest[]
  subcategoryRequests  ServiceRequest[]      @relation("SubcategoryRequest")
  skills               Skill[]
  intakeCategoryRoutes IntakeCategoryRoute[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  categoryId  String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  users    UserSkill[]

  @@index([slug])
  @@index([categoryId])
}

model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  level      Int      @default(1)
  experience String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ============ SERVICE REQUESTS ============

model ServiceRequest {
  id                 String           @id @default(cuid())
  title              String
  slug               String           @unique
  description        String
  budgetMin          BigInt?
  budgetMax          BigInt?
  budgetType         BudgetType       @default(FIXED)
  deliveryTime       Int?
  deliveryUnit       String           @default("day")
  city               String?
  province           String?
  address            String?
  lat                Float?
  lng                Float?
  categoryId         String
  subcategoryId      String?
  priority           Priority         @default(NORMAL)
  status             RequestStatus    @default(PENDING_REVIEW)
  moderationStatus   ModerationStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewedByUserId   String?
  rejectionReason    String?
  moderationNotes    String?
  assignedToUserId   String?
  tags               String           @default("[]")
  attachmentUrls     String           @default("[]")
  viewCount          Int              @default(0)
  proposalCount      Int              @default(0)
  isFeatured         Boolean          @default(false)
  expiresAt          DateTime?
  closedAt           DateTime?
  selectedProposalId String?
  intentType         String?
  dynamicAnswers     String           @default("{}")
  aiExtractedData    String           @default("{}")
  source             String           @default("form")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user                  User                    @relation(fields: [userId], references: [id])
  userId                String
  businessProfile       BusinessProfile?        @relation(fields: [businessProfileId], references: [id])
  businessProfileId     String?
  reviewedBy            User?                   @relation("ReviewedRequests", fields: [reviewedByUserId], references: [id])
  assignedTo            User?                   @relation("AssignedRequests", fields: [assignedToUserId], references: [id])
  category              Category                @relation(fields: [categoryId], references: [id])
  subcategory           Category?               @relation("SubcategoryRequest", fields: [subcategoryId], references: [id])
  proposals             Proposal[]
  reviews               Review[]
  leadOutreach          NeedLeadOutreach[]
  needChatSessions      NeedChatSession[]
  resolutionDisputes    NeedResolutionDispute[]
  intakeTrainingExample IntakeTrainingExample?

  needAccessStatus                     NeedAccessStatus @default(PRIVATE)
  vipExpiresAt                         DateTime?
  resolvedBusinessProfileId            String?
  resolvedAt                           DateTime?
  pendingVerificationBusinessProfileId String?

  searchText           String?
  searchEmbedding      Unsupported("vector(384)")?
  embeddingModel       String?
  embeddedAt           DateTime?
  embeddingContentHash String?

  @@index([userId])
  @@index([businessProfileId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([slug])
  @@index([intentType])
  @@index([source])
  @@index([moderationStatus])
  @@index([moderationStatus, createdAt])
  @@index([assignedToUserId, moderationStatus])
  @@index([reviewedByUserId])
  @@index([needAccessStatus])
  @@index([vipExpiresAt])
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED_SOFT
  REJECTED_FINAL
}

model NeedIntakeSession {
  id           String   @id @default(cuid())
  userId       String?
  status       String   @default("active")
  parsedIntent String   @default("{}")
  answers      String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/**
 * Canonical migration observability — event log for intake domain migration control.
 */
model IntakeMigrationEvent {
  id        String   @id @default(cuid())
  type      String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([type, createdAt])
}

/**
 * CCQS — Continuous Cognitive Quality System (`PLAN/ccqs-architecture.md`). Permanent quality /
 * release-gating platform surrounding the Cognitive Engine and SEE — not part of either. Append-
 * only: no CCQS code path ever UPDATEs a CcqsComparisonRecord, CcqsGatePolicy, or CcqsGateVerdict
 * row once written (mirrors SEE's Historical Record discipline, semantic-comparator-architecture.md
 * §16). The only mutable fields anywhere are CcqsReplayRun.status/completedAt, describing the
 * run's own lifecycle, never a historical result.
 */
model CcqsEngineVersion {
  id                      String   @id @default(cuid())
  label                   String
  cognitiveEngineVersion  String
  semanticContractVersion String
  comparatorEngineVersion String
  rulesRegistryVersion    String
  ontologyVersions        String // JSON: Record<namespace, string>
  gitCommit               String?
  createdAt               DateTime @default(now())

  replayRuns CcqsReplayRun[]

  @@index([createdAt])
}

model CcqsReplayRun {
  id              String            @id @default(cuid())
  engineVersionId String
  engineVersion   CcqsEngineVersion @relation(fields: [engineVersionId], references: [id])
  datasetRef      String
  status          String // 'running' | 'completed' | 'failed'
  triggeredBy     String // 'manual' | 'ci' | 'scheduled'
  startedAt       DateTime          @default(now())
  completedAt     DateTime?

  comparisons  CcqsComparisonRecord[]
  gateVerdicts CcqsGateVerdict[]

  @@index([datasetRef])
  @@index([status])
}

model CcqsComparisonRecord {
  id               String        @id @default(cuid())
  replayRunId      String
  replayRun        CcqsReplayRun @relation(fields: [replayRunId], references: [id])
  caseId           String
  comparisonReport String // JSON — SEE's ComparisonReport, verbatim
  finalEvaluation  String // JSON — SEE's FinalEvaluation, verbatim
  ruleTrace        String // JSON — RuleTraceEntry[], CCQS-only (SEE doesn't carry this)
  createdAt        DateTime      @default(now())

  @@index([replayRunId])
  @@index([caseId])
}

model CcqsGatePolicy {
  id            String   @id @default(cuid())
  policyId      String
  policyVersion String
  thresholds    String // JSON
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  gateVerdicts CcqsGateVerdict[]

  @@unique([policyId, policyVersion])
}

model CcqsGateVerdict {
  id           String         @id @default(cuid())
  replayRunId  String
  replayRun    CcqsReplayRun  @relation(fields: [replayRunId], references: [id])
  gatePolicyId String
  gatePolicy   CcqsGatePolicy @relation(fields: [gatePolicyId], references: [id])
  verdict      String
  reasons      String // JSON
  decidedAt    DateTime       @default(now())

  @@index([replayRunId])
}

/**
 * PVW MetricSnapshot Time Series Store — `PLAN/production-validation-window-architecture.md`
 * §2.2 module 3 (closes gap G6). Append-only Derived-View CACHE: every row is mechanically
 * reproducible from CcqsComparisonRecords (pillar='golden') or IntakeMigrationEvent shadow
 * events (pillar='production') — never a second source of truth (SEE §16.2 discipline).
 * `windowSpecVersion` stamps the bucketing definition (PVW §2.3): old rows stay valid under
 * their original spec forever, never recomputed under a new one (SEE INV-11 discipline).
 */
model CcqsMetricSnapshot {
  id                      String    @id @default(cuid())
  pillar                  String // 'golden' | 'production'
  windowSpecVersion       String
  /// pillar='golden': the ReplayRun this snapshot summarizes. Null for production buckets.
  replayRunId             String?
  /// pillar='production': UTC bucket boundaries. Null for golden (run-scoped) snapshots.
  bucketStart             DateTime?
  bucketEnd               DateTime?
  /// JSON — QualityMetricSnapshot (golden) or ProductionMetricSnapshot (production), verbatim.
  metrics                 String
  /// EngineVersionManifest lineage fields (PVW §2.3). Nullable for production buckets that
  /// aggregate events written before shadow version-stamping existed (pre-G4-closure history).
  engineLabel             String?
  cognitiveEngineVersion  String?
  rulesRegistryVersion    String?
  comparatorEngineVersion String?
  computedAt              DateTime  @default(now())

  @@index([pillar, bucketStart])
  @@index([replayRunId])
}

/**
 * PVW Alert store — PVW §5. Append-only: fired alerts are Historical Record, never mutated or
 * "resolved" in place; a resolution is a NEW event referencing the original via
 * `resolvesAlertEventId`. `alertPolicyVersion` pins the threshold set that fired it (PVW §2.3 —
 * a later policy change never retroactively changes what a past alert meant).
 */
model CcqsAlertEvent {
  id                   String   @id @default(cuid())
  alertPolicyId        String
  alertPolicyVersion   String
  alertKey             String // e.g. 'category-accuracy-drop', 'ambiguity-spike'
  severity             String // 'critical' | 'warning'
  detail               String // JSON — trigger values, thresholds, window refs
  /// CcqsMetricSnapshot ids this alert was computed from — JSON array.
  sourceSnapshotIds    String
  resolvesAlertEventId String?
  firedAt              DateTime @default(now())

  @@index([alertKey, firedAt])
  @@index([severity])
}

/**
 * Captured intake publish examples for learning pipeline (non-blocking).
 */
model IntakeTrainingExample {
  id                 String    @id @default(cuid())
  sourceText         String
  needType           String?
  ruleResult         Json?
  aiResult           Json?
  finalEntities      Json
  finalNeedDraft     Json?
  intakeTrace        Json?
  serviceRequestId   String?   @unique
  publishedAt        DateTime  @default(now())
  reviewed           Boolean   @default(false)
  reviewedBy         String?
  reviewedAt         DateTime?
  correctedEntities  Json?
  qualityScore       Float?
  qualityFlags       String[]  @default([])
  sourceTextHash     String?
  moderationLabel    String?
  sessionId          String?
  hasUserCorrections Boolean   @default(false)
  correctionFields   String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([reviewed])
  @@index([publishedAt])
  @@index([needType])
  @@index([reviewed, publishedAt])
  @@index([sourceTextHash])
  @@index([moderationLabel])
  @@index([sessionId])
  @@index([hasUserCorrections])
}

/**
 * Persisted validation reject events for analytics.
 */
model IntakeValidationRejectEvent {
  id        String   @id @default(cuid())
  reason    String
  field     String?
  value     String?
  detail    String?
  provider  String?
  createdAt DateTime @default(now())

  @@index([reason])
  @@index([createdAt])
  @@index([reason, createdAt])
}

/**
 * Candidate coverage failures — expected category missing from candidate list.
 */
model IntakeCandidateFailureEvent {
  id                 String   @id @default(cuid())
  sourceText         String?
  expectedCategory   String?
  candidateSlugs     String   @default("[]")
  aiSelectedCategory String?
  publishedCategory  String?
  coverage           Boolean  @default(false)
  serviceRequestId   String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([coverage])
  @@index([expectedCategory])
}

enum BudgetType {
  FIXED
  HOURLY
  NEGOTIABLE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING_AI_REVIEW
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  CLOSED
  COMPLETED
  CANCELLED
  REJECTED
}

enum NeedAccessStatus {
  PRIVATE
  PUBLIC
  PENDING_VERIFICATION
  RESOLVED
  EXPIRED
}

enum NeedChatSessionStatus {
  ACTIVE
  CLOSED
}

enum NeedAccessPhase {
  PRIVATE
  PUBLIC
}

// ============ PROPOSALS ============

model Proposal {
  id             String         @id @default(cuid())
  price          Int
  deliveryTime   Int?
  deliveryUnit   String         @default("day")
  message        String
  attachmentUrls String         @default("[]")
  status         ProposalStatus @default(PENDING)
  isRead         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  userId    String
  requestId String
  user      User           @relation(fields: [userId], references: [id])
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ============ PORTFOLIO ============

model Portfolio {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrls   String    @default("[]")
  videoUrl    String?
  projectUrl  String?
  clientName  String?
  completedAt DateTime?
  order       Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublished])
}

// ============ UNIVERSAL BUSINESS PROFILE ============

model BusinessProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  name                  String
  slug                  String         @unique
  logo                  String?
  coverImage            String?
  description           String?
  categorySlugs         String         @default("[]")
  tags                  String         @default("[]")
  city                  String?
  province              String?
  address               String?
