generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String?
  phone         String?   @unique
  username      String?   @unique
  firstName     String    @default("")
  lastName      String    @default("")
  displayName   String?
  avatar        String?
  coverImage    String?
  website       String?
  bio           String?
  city          String?
  province      String?
  address       String?
  role          UserRole  @default(CLIENT)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  isBanned      Boolean   @default(false)
  banReason     String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastSeenAt    DateTime?
  online        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sentMessages       Message[]         @relation("SentMessages")
  messageDeliveries  MessageDelivery[]
  messageReactions   MessageReaction[]
  blockedUsers       UserBlock[]       @relation("UserBlocks")
  blockedByUsers     UserBlock[]       @relation("BlockedByUsers")
  sentProposals      Proposal[]
  requests           ServiceRequest[]
  reviews            Review[]
  givenReviews       Review[]         @relation("ReviewAuthor")
  wallet             Wallet?
  notifications      Notification[]
  portfolios         Portfolio[]
  skills             UserSkill[]
  transactions       Transaction[]
  authTokens         AuthToken[]
  staffRoles         UserStaffRole[]
  adminAuditLogs     AdminAuditLog[]
  conversations1     Conversation[]     @relation("ConvUser1")
  conversations2     Conversation[]     @relation("ConvUser2")
  posts              UserPost[]
  postComments       PostComment[]
  postLikes          PostLike[]
  bookmarks          Bookmark[]
  followers          Follow[]           @relation("Followers")
  following          Follow[]           @relation("Following")
  businessProfile    BusinessProfile?
  callsAsCaller      VoiceCall[]     @relation("VoiceCallsAsCaller")
  callsAsCallee      VoiceCall[]     @relation("VoiceCallsAsCallee")
  reviewedRequests   ServiceRequest[] @relation("ReviewedRequests")
  assignedRequests   ServiceRequest[] @relation("AssignedRequests")
  needBrowseAlerts   NeedBrowseAlert[]
  analyticsSessions  AnalyticsSession[]
  businessMemberships BusinessMember[]
  assignedContactPoints BusinessContactPoint[] @relation("ContactPointAssignee")
  businessInvitesSent BusinessMemberInvite[] @relation("BusinessInviteInviter")
  businessInvitesAccepted BusinessMemberInvite[] @relation("BusinessInviteAcceptor")
  chatReplyTemplates ChatReplyTemplate[]
  staffAuditLogs     StaffAuditLog[]

  @@index([role])
  @@index([city])
  @@index([isVerified])
  @@index([isActive])
}

enum UserRole {
  CLIENT
  SPECIALIST
  ADMIN
  SUPER_ADMIN
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  type      String   @default("refresh")
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============ STAFF RBAC (Super Admin) ============

model StaffRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions StaffRolePermission[]
  users       UserStaffRole[]

  @@unique([name])
  @@index([isActive])
}

model StaffPermission {
  /**
   * Canonical permission id, e.g. `geo:locations:write`.
   * Source of truth in code: `src/config/admin-permissions.ts`.
   */
  id          String   @id
  label       String
  group       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles StaffRolePermission[]

  @@index([group])
}

model StaffRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       StaffRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission StaffPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserStaffRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  payload     String   @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ============ CATEGORIES & SKILLS ============

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  image       String?
  parentId    String?
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]      @relation("CategoryHierarchy")
  requests    ServiceRequest[]
  subcategoryRequests ServiceRequest[] @relation("SubcategoryRequest")
  skills      Skill[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
}

model Skill {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  categoryId  String?
  icon        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  users       UserSkill[]

  @@index([slug])
  @@index([categoryId])
}

model UserSkill {
  id         String   @id @default(cuid())
  userId     String
  skillId    String
  level      Int      @default(1)
  experience String?
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

// ============ SERVICE REQUESTS ============

model ServiceRequest {
  id            String           @id @default(cuid())
  title         String
  slug          String           @unique
  description   String
  budgetMin     BigInt?
  budgetMax     BigInt?
  budgetType    BudgetType       @default(FIXED)
  deliveryTime  Int?
  deliveryUnit  String           @default("day")
  city          String?
  province      String?
  address       String?
  categoryId    String
  subcategoryId String?
  priority      Priority         @default(NORMAL)
  status        RequestStatus    @default(PENDING_REVIEW)
  moderationStatus ModerationStatus @default(PENDING)
  reviewedAt       DateTime?
  reviewedByUserId String?
  rejectionReason  String?
  moderationNotes  String?
  assignedToUserId String?
  tags          String           @default("[]")
  attachmentUrls String          @default("[]")
  viewCount     Int              @default(0)
  proposalCount Int              @default(0)
  isFeatured    Boolean          @default(false)
  expiresAt     DateTime?
  closedAt      DateTime?
  selectedProposalId String?
  intentType        String?
  dynamicAnswers    String           @default("{}")
  aiExtractedData   String           @default("{}")
  source            String           @default("form")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user              User           @relation(fields: [userId], references: [id])
  userId            String
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id])
  businessProfileId String?
  reviewedBy        User?          @relation("ReviewedRequests", fields: [reviewedByUserId], references: [id])
  assignedTo        User?          @relation("AssignedRequests", fields: [assignedToUserId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])
  subcategory       Category?      @relation("SubcategoryRequest", fields: [subcategoryId], references: [id])
  proposals         Proposal[]
  reviews           Review[]
  leadOutreach      NeedLeadOutreach[]
  intakeTrainingExample IntakeTrainingExample?

  @@index([userId])
  @@index([businessProfileId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([slug])
  @@index([intentType])
  @@index([source])
  @@index([moderationStatus])
  @@index([moderationStatus, createdAt])
  @@index([assignedToUserId, moderationStatus])
  @@index([reviewedByUserId])
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED_SOFT
  REJECTED_FINAL
}

model NeedIntakeSession {
  id           String   @id @default(cuid())
  userId       String?
  status       String   @default("active")
  parsedIntent String   @default("{}")
  answers      String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/** Canonical migration observability — event log for intake domain migration control. */
model IntakeMigrationEvent {
  id        String   @id @default(cuid())
  type      String
  payload   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([type, createdAt])
}

/** Captured intake publish examples for learning pipeline (non-blocking). */
model IntakeTrainingExample {
  id                String   @id @default(cuid())
  sourceText        String
  needType          String?
  ruleResult        Json?
  aiResult          Json?
  finalEntities     Json
  finalNeedDraft    Json?
  intakeTrace       Json?
  serviceRequestId  String?  @unique
  publishedAt       DateTime @default(now())
  reviewed          Boolean  @default(false)
  reviewedBy        String?
  reviewedAt        DateTime?
  correctedEntities Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([reviewed])
  @@index([publishedAt])
  @@index([needType])
  @@index([reviewed, publishedAt])
}

/** Persisted validation reject events for analytics. */
model IntakeValidationRejectEvent {
  id        String   @id @default(cuid())
  reason    String
  field     String?
  value     String?
  detail    String?
  provider  String?
  createdAt DateTime @default(now())

  @@index([reason])
  @@index([createdAt])
  @@index([reason, createdAt])
}

/** Candidate coverage failures — expected category missing from candidate list. */
model IntakeCandidateFailureEvent {
  id                 String   @id @default(cuid())
  sourceText         String?
  expectedCategory   String?
  candidateSlugs     String   @default("[]")
  aiSelectedCategory String?
  publishedCategory  String?
  coverage           Boolean  @default(false)
  serviceRequestId   String?
  createdAt          DateTime @default(now())

  @@index([createdAt])
  @@index([coverage])
  @@index([expectedCategory])
}

enum BudgetType {
  FIXED
  HOURLY
  NEGOTIABLE
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestStatus {
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  CLOSED
  COMPLETED
  CANCELLED
  REJECTED
}

// ============ PROPOSALS ============

model Proposal {
  id            String        @id @default(cuid())
  price         Int
  deliveryTime  Int?
  deliveryUnit  String        @default("day")
  message       String
  attachmentUrls String       @default("[]")
  status        ProposalStatus @default(PENDING)
  isRead        Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  requestId     String
  user          User          @relation(fields: [userId], references: [id])
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ============ PORTFOLIO ============

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrls   String   @default("[]")
  videoUrl    String?
  projectUrl  String?
  clientName  String?
  completedAt DateTime?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublished])
}

// ============ UNIVERSAL BUSINESS PROFILE ============

model BusinessProfile {
  id          String         @id @default(cuid())
  userId      String         @unique
  name        String
  slug        String         @unique
  logo        String?
  coverImage  String?
  description String?
  categorySlugs String       @default("[]")
  tags        String         @default("[]")
  city        String?
  province    String?
  address     String?
  lat         Float?
  lng         Float?
  status      BusinessStatus @default(INACTIVE)
  onboardingCompletedAt DateTime?

  rating        Float   @default(0)
  reviewCount   Int     @default(0)
  verified      Boolean @default(false)
  badges        String  @default("[]")
  responseRate  Float   @default(0)
  responseTime  String?
  yearsActive   Int     @default(0)

  phone       String?
  whatsapp    String?
  email       String?
  chatEnabled Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  seoKeywords    String  @default("[]")

  viewCount         Int @default(0)
  clickCount        Int @default(0)
  conversionCount   Int @default(0)
  saveCount         Int @default(0)

  aiAssistantConfig String @default("{}")
  extensions        String @default("{}")
  leadAlertsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers         BusinessOffer[]
  portfolioItems BusinessPortfolioItem[]
  profileReviews BusinessProfileReview[]
  leadOutreach   NeedLeadOutreach[]
  linkedRequests ServiceRequest[]
  members        BusinessMember[]
  contactPoints  BusinessContactPoint[]
  memberInvites  BusinessMemberInvite[]
  locations      BusinessLocation[]
  analyticsDaily BusinessAnalyticsDaily[]

  @@index([slug])
  @@index([city])
  @@index([status])
  @@index([verified])
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

model BusinessOffer {
  id          String       @id @default(cuid())
  profileId   String
  title       String
  description String
  priceRange  String?
  duration    String?
  images      String       @default("[]")
  features    String       @default("[]")
  faq         String       @default("[]")
  ctaType     OfferCtaType @default(CHAT)
  order       Int          @default(0)
  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([isPublished])
}

enum OfferCtaType {
  BOOK
  QUOTE
  CALL
  CHAT
}

model BusinessPortfolioItem {
  id          String             @id @default(cuid())
  profileId   String
  type        PortfolioMediaType @default(IMAGE)
  title       String
  description String?
  mediaUrl    String
  metadata    String             @default("{}")
  order       Int                @default(0)
  isPublished Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([isPublished])
}

enum PortfolioMediaType {
  IMAGE
  VIDEO
  BEFORE_AFTER
}

model BusinessProfileReview {
  id        String   @id @default(cuid())
  profileId String
  userName  String
  rating    Int
  comment   String
  reply     String?
  authorId  String?
  isPublished Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([rating])
  @@index([createdAt])
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum BusinessInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model BusinessMember {
  id              String               @id @default(cuid())
  profileId       String
  userId          String
  role            BusinessMemberRole   @default(STAFF)
  status          BusinessMemberStatus @default(ACTIVE)
  invitedByUserId String?
  joinedAt        DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([profileId, status])
  @@index([userId])
}

model BusinessContactPoint {
  id               String   @id @default(cuid())
  profileId        String
  label            String
  slug             String
  description      String?
  assignedUserId   String
  displayName      String?
  avatar           String?
  chatEnabled      Boolean  @default(true)
  voiceEnabled     Boolean  @default(true)
  isDefault        Boolean  @default(false)
  sortOrder        Int      @default(0)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile        BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assignedUser   User            @relation("ContactPointAssignee", fields: [assignedUserId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@unique([profileId, slug])
  @@index([profileId, isPublished, sortOrder])
  @@index([assignedUserId])
}

model BusinessMemberInvite {
  id              String               @id @default(cuid())
  profileId       String
  phone           String
  role            BusinessMemberRole   @default(STAFF)
  token           String               @unique
  status          BusinessInviteStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedUserId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  profile       BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invitedBy     User            @relation("BusinessInviteInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedUser  User?           @relation("BusinessInviteAcceptor", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@index([phone, status])
}

// ============ MESSAGES & CHAT ============

model Conversation {
  id                String   @id @default(cuid())
  requestId         String?
  businessProfileId String?
  contactPointId    String?
  userId1           String
  userId2           String
  lastMessage       String?
  lastMessageAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user1         User                  @relation("ConvUser1", fields: [userId1], references: [id])
  user2         User                  @relation("ConvUser2", fields: [userId2], references: [id])
  contactPoint  BusinessContactPoint? @relation(fields: [contactPointId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@index([userId1])
  @@index([userId2])
  @@index([requestId])
  @@index([businessProfileId])
  @@index([contactPointId])
  @@index([lastMessageAt])
  @@index([userId1, userId2, requestId, contactPointId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType @default(TEXT)
  attachmentUrls String      @default("[]")
  isRead         Boolean     @default(false)
  readAt         DateTime?
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedFor     String      @default("[]")
  clientTempId   String?
  isPinned       Boolean     @default(false)
  pinnedBy       String?
  pinnedAt       DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  deliveries   MessageDelivery[]
  reactions    MessageReaction[]

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@index([replyToId])
  @@index([clientTempId])
  @@index([isPinned])
}

model MessageDelivery {
  messageId String
  userId    String
  readAt    DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
  NEED_CARD
  OFFER_CARD
  CALL
  PROPOSAL
}

enum VoiceCallStatus {
  INITIATED
  RINGING
  ACTIVE
  ENDED
  REJECTED
  MISSED
}

model VoiceCall {
  id             String          @id @default(cuid())
  callerId       String
  calleeId       String
  conversationId String?
  status         VoiceCallStatus @default(INITIATED)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?
  durationSec    Int?
  janusRoomId    Int?
  janusPin       String?
  turnUsername   String?
  /** JSON SDP offer for callee polling fallback (cleared when call ends) */
  signalingOffer String?
  /** JSON SDP answer for caller polling fallback (cleared when call ends) */
  signalingAnswer String?

  caller User @relation("VoiceCallsAsCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee User @relation("VoiceCallsAsCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([callerId])
  @@index([calleeId])
  @@index([status])
  @@index([startedAt])
}

enum NeedLeadOutreachStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

model NeedLeadOutreach {
  id                String                 @id @default(cuid())
  requestId         String
  businessProfileId String
  businessUserId    String
  matchScore        Float                  @default(0)
  matchReasonFa     String                 @default("")
  status            NeedLeadOutreachStatus @default(QUEUED)
  skipReason        String?
  conversationId    String?
  introMessageId    String?
  cardMessageId     String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  request  ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  business BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@unique([requestId, businessUserId])
  @@index([businessUserId])
  @@index([requestId])
  @@index([status])
  @@index([createdAt])
}

// ============ REVIEWS & RATINGS ============

model Review {
  id            String   @id @default(cuid())
  rating        Int
  comment       String?
  response      String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authorId      String
  userId        String
  requestId     String
  author        User           @relation("ReviewAuthor", fields: [authorId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  request       ServiceRequest @relation(fields: [requestId], references: [id])

  @@index([authorId])
  @@index([userId])
  @@index([requestId])
  @@index([rating])
}

// ============ WALLET & PAYMENTS ============

model Wallet {
  id         String   @id @default(cuid())
  userId     String   @unique
  balance    Int      @default(0)
  frozen     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  walletId      String
  userId        String
  type          TransactionType
  amount        Int
  description   String?
  referenceId   String?
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  ESCROW_HOLD
  ESCROW_RELEASE
  PAYMENT
  REFUND
  COMMISSION
  BONUS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// ============ NOTIFICATIONS ============

/** اشتراک اعلان برای صفحهٔ مرور نیاز (دسته + شهر + فیلترها) */
model NeedBrowseAlert {
  id            String   @id @default(cuid())
  userId        String
  label         String
  browsePath    String
  categorySlug  String?
  citySlugs     String   @default("[]")
  filtersJson   String   @default("{}")
  searchQuery   String?
  fingerprint   String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, active])
  @@index([categorySlug])
  @@index([fingerprint])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  data      String   @default("{}")
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============ ADMIN & SYSTEM ============

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Report {
  id          String      @id @default(cuid())
  reporterId  String
  targetType  String
  targetId    String
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([reporterId])
  @@index([targetType])
  @@index([targetId])
  @@index([status])
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============ COUPONS & REFERRALS ============

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  type        CouponType @default(PERCENTAGE)
  value       Int
  minAmount   Int?
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SERVICE
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  code        String
  reward      Int      @default(0)
  isClaimed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([referrerId])
  @@index([referredId])
  @@index([code])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  type      String
  targetId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
  @@index([userId])
  @@index([type, targetId])
}

model UserPost {
  id           String   @id @default(cuid())
  userId       String
  content      String
  imageUrls    String   @default("[]")
  isPrivate    Boolean  @default(false)
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments PostComment[]
  likes    PostLike[]

  @@index([userId])
  @@index([createdAt])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post UserPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============ FIRST-PARTY ANALYTICS ============

model AnalyticsSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  visitorId     String
  userId        String?
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  device        String?
  browser       String?
  os            String?
  country       String?  @default("IR")
  province      String?
  city          String?
  ipHash        String?
  landingPath   String?
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  utmTerm       String?
  pageViewCount Int      @default(0)
  eventCount    Int      @default(0)
  totalDurationMs Int    @default(0)

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]

  @@index([visitorId])
  @@index([lastSeen])
  @@index([userId])
  @@index([firstSeen])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  sessionId  String
  visitorId  String
  userId     String?
  type       String
  name       String?
  path       String
  title      String?
  referrer   String?
  durationMs Int?
  properties Json     @default("{}")
  dimensions Json     @default("{}")
  device     String?
  browser    String?
  os         String?
  country    String?
  province   String?
  city       String?
  createdAt  DateTime @default(now())

  session AnalyticsSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([createdAt])
  @@index([sessionId])
  @@index([type, createdAt])
  @@index([visitorId])
  @@index([path])
}

model AnalyticsDailyRollup {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  dimensionKey   String   @default("_total")
  dimensionValue String   @default("_all")
  sessions       Int      @default(0)
  pageViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  events         Int      @default(0)
  avgDurationMs  Int      @default(0)
  data           Json     @default("{}")

  @@unique([date, dimensionKey, dimensionValue])
  @@index([date])
  @@index([dimensionKey, dimensionValue])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  content        String         @db.Text
  excerpt        String?        @db.Text
  coverImage     String?
  authorName     String?
  seoTitle       String?
  seoDescription String?        @db.Text
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
}

model BusinessAnalyticsDaily {
  id          String   @id @default(cuid())
  profileId   String
  date        DateTime @db.Date
  views       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  saves       Int      @default(0)

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId, date])
}

model BusinessLocation {
  id          String   @id @default(cuid())
  profileId   String
  label       String
  city        String
  province    String?
  address     String?
  lat         Float?
  lng         Float?
  isPrimary   Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isPublished, sortOrder])
  @@index([city])
}

model ChatReplyTemplate {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model StaffAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  payload     String   @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
