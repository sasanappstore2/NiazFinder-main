}

model AnalyticsDailyRollup {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  dimensionKey   String   @default("_total")
  dimensionValue String   @default("_all")
  sessions       Int      @default(0)
  pageViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  events         Int      @default(0)
  avgDurationMs  Int      @default(0)
  data           Json     @default("{}")

  @@unique([date, dimensionKey, dimensionValue])
  @@index([date])
  @@index([dimensionKey, dimensionValue])
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  content        String         @db.Text
  excerpt        String?        @db.Text
  coverImage     String?
  authorName     String?
  seoTitle       String?
  seoDescription String?        @db.Text
  status         BlogPostStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, publishedAt])
  @@index([createdAt])
}

model BusinessAnalyticsDaily {
  id          String   @id @default(cuid())
  profileId   String
  date        DateTime @db.Date
  views       Int      @default(0)
  clicks      Int      @default(0)
  conversions Int      @default(0)
  saves       Int      @default(0)

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId, date])
}

model BusinessLocation {
  id          String   @id @default(cuid())
  profileId   String
  label       String
  city        String
  province    String?
  address     String?
  lat         Float?
  lng         Float?
  isPrimary   Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile BusinessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isPublished, sortOrder])
  @@index([city])
}

model ChatReplyTemplate {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

model StaffAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  entityType  String
  entityId    String?
  payload     String   @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

enum CollaborationPropertyKind {
  APARTMENT
  VILLA
  LAND
  COMMERCIAL
  OTHER
}

enum CollaborationAreaBand {
  UNDER_80
  BAND_80_120
  BAND_120_180
  OVER_180
}

enum CollaborationBudgetBand {
  SALE_UNDER_3B
  SALE_3_5B
  SALE_5_8B
  SALE_8_12B
  SALE_OVER_12B
  RENT_UNDER_10M
  RENT_10_20M
  RENT_20_40M
  RENT_OVER_40M
}

enum CollaborationPostIntent {
  CLIENT_REFERRAL
  SEEK_PARTNER
  CO_SHOWING
}

enum CollaborationPostScope {
  REGIONAL
  CROSS_REGIONAL
}

enum CollaborationSubjectKind {
  CLIENT
  PROPERTY
  JOINT_VISIT
}

model RegionalCollaborationPost {
  id                 String                  @id @default(cuid())
  authorProfileId    String
  intent             CollaborationPostIntent
  headline           String
  note               String?
  scope              CollaborationPostScope  @default(REGIONAL)
  city               String?
  neighborhood       String?
  neighborhoodId     String?
  targetCity         String?
  targetNeighborhood String?
  subjectKind        CollaborationSubjectKind?
  dealType           String?
  propertyKind       CollaborationPropertyKind?
  areaBand           CollaborationAreaBand?
  budgetBand         CollaborationBudgetBand?
  targetAreasJson    String                  @default("[]")
  status             String                  @default("active")
  createdAt          DateTime                @default(now())
  expiresAt          DateTime?

  author BusinessProfile @relation(fields: [authorProfileId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([city])
  @@index([targetCity])
  @@index([authorProfileId])
}

/** Central regional property filings — imported via super-admin for workspace feeds. */
model RegionalFiling {
  id             String   @id @default(cuid())
  fileCode       String?
  title          String
  description    String?
  dealType       String?
  categorySlug   String?
  propertyKind   String?
  city           String
  cityId         String?
  district       String?
  neighborhood   String?
  neighborhoodId String?
  location       String?
  price          String?
  deposit        String?
  monthlyRent    String?
  area           String?
  rooms          Int?
  floor          Int?
  pricePerMeter  String?
  postedAt       DateTime?
  totalFloors    Int?
  unitsCount     Int?
  buildingAge    Int?
  documentType   String?
  cabinet        String?
  flooring       String?
  wallCover      String?
  facade         String?
  orientation    String?
  heating        String?
  cooling        String?
  exchangeable   Boolean?
  hasParking     Boolean?
  hasStorage     Boolean?
  hasElevator    Boolean?
  hasSecurityDoor Boolean?
  hasTerrace     Boolean?
  hasBuiltInWardrobe Boolean?
  detailUrl      String?
  dataCompleteness Int?
  enrichedAt     DateTime?
  sourceMetaJson  String   @default("{}")
  image          String?
  imagesJson     String   @default("[]")
  status         String   @default("active")
  reviewIssuesJson String?
  scrapedAt      DateTime?
  createdById    String?
  scraperId      String?
  externalId     String?
  sourceSite     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  scraper RegionalFilingScraper? @relation(fields: [scraperId], references: [id], onDelete: SetNull)

  @@unique([scraperId, externalId])
  @@index([status, createdAt(sort: Desc)])
  @@index([city])
  @@index([cityId])
  @@index([neighborhoodId])
  @@index([scraperId])
  @@index([dealType])
  @@index([propertyKind])
  @@index([postedAt])
  @@index([status, cityId, dealType, postedAt(sort: Desc)])
  @@index([status, city, dealType, postedAt(sort: Desc)])
  @@map("regional_filings")
}

/** Per-site filing feed bot — login + ScrapeGraph scrape on interval. */
model RegionalFilingScraper {
  id                    String    @id @default(cuid())
  name                  String
  siteKey               String    @unique
  enabled               Boolean   @default(true)
  loginUrl              String
  listingsUrl           String
  username              String    @default("")
  passwordEnc           String?
  siteConfigJson        String    @default("{}")
  defaultCity           String
  defaultCityId         String?
  defaultNeighborhood   String?
  defaultNeighborhoodId String?
  intervalMinutes       Int       @default(10)
  jitterMinutes         Int       @default(4)
  status                String    @default("idle")
  lastRunAt             DateTime?
  lastSuccessAt         DateTime?
  lastImportedCount     Int       @default(0)
  lastError             String?
  failureCount          Int       @default(0)
  evalScore             Float?
  lastEvalAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  filings RegionalFiling[]

  @@index([enabled, lastRunAt])
  @@map("regional_filing_scrapers")
}
